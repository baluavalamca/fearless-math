  "alternateMethods": [
    {
      "name": "स्तंभ विधि (स्कूल शैली)",
      "whenToUse": "परीक्षा के लिए — यह वही तोड़ो-जोड़ो विधि है, बस संक्षेप में लिखी गई।",
      "steps": [
        "24 को × 5 के ऊपर लिखो।",
