{
  "id": "ops-11-area-multiplication",
  "name": "बड़ा गुणा — तोड़ो-जोड़ो (क्षेत्रफल) विधि",
  "grade": 4,
  "strand": "operations",
  "prerequisites": [
    "ops-09-multiplication-groups"
  ],
  "whatIsIt": "बड़ी संख्याओं को गुणा करने के लिए, उन्हें स्थानीय-मान के अनुकूल टुकड़ों में तोड़ो, आसान टुकड़ों को गुणा करो, और जोड़ो। 24 × 5 बन जाता है (20 × 5) + (4 × 5) = 100 + 20 = 120। एक आयत को हिस्सों में बांटकर बनाया गया चित्र क्षेत्रफल मॉडल है — तुम देख सकते हो कि यह तरकीब क्यों काम करती है।",
  "whyNeeded": "पहाड़े 10 पर रुक जाते हैं, पर ज़िंदगी नहीं रुकती! प्रति डिब्बा 24 चॉकलेट, 5 डिब्बे — तुम्हें 24 × 5 चाहिए। तोड़ो-जोड़ो विधि हर बड़े गुणा को उन छोटे पहाड़ों में बदल देती है जो तुम पहले से जानते हो। यह स्कूल की स्तंभ विधि के भीतर छिपा इंजन भी है और उस बीजगणित का भी, जिससे तुम आगे मिलोगे।",
  "realLifeUses": [
    "डिब्बे: पार्टी के लिए प्रति डिब्बा 24 चॉकलेट × 5 डिब्बे",
    "पैसे: ₹32 प्रति टिकट के हिसाब से 5 टिकट",
    "सीटें: स्कूल हॉल में 45 कुर्सियों की 6 पंक्तियाँ",
    "दिन: रोज़ 15 पन्ने पढ़ने के 3 हफ़्ते"
  ],
  "vocabulary": [
    {
      "term": "तोड़ना",
      "meaning": "एक संख्या को स्थानीय-मान के टुकड़ों में बांटना: 24 = 20 + 4।"
    },
    {
      "term": "क्षेत्रफल मॉडल",
      "meaning": "हिस्सों में कटा एक आयत — हर हिस्से का क्षेत्रफल एक छोटा गुणा है।"
    },
    {
      "term": "आंशिक गुणनफल",
      "meaning": "वे छोटे उत्तर (100 और 20) जो जुड़कर अंतिम गुणनफल बनाते हैं।"
    }
  ],
  "story": {
    "title": "नारियल के बाग़ की गिनती",
    "characters": [
      "रवि",
      "बाग़ का माली"
    ],
    "text": "एक नारियल के बाग़ में 5 लंबी पंक्तियाँ हैं, हर पंक्ति में 24 पेड़। 'कितने पेड़ हैं?' रवि पूछता है। माली इसे तोड़ता है: '24 को 20 और 4 में बांटो। 20 की पांच पंक्तियाँ 100 हैं; 4 की पांच पंक्तियाँ 20 हैं। दोनों टुकड़ों को जोड़ो: 100 और 20 मिलकर 120 पेड़ बनते हैं। किसी बड़ी संख्या को तोड़ो और गुणा आसान हो जाता है!'",
    "extractedProblem": "24-24 पेड़ों वाली 5 पंक्तियाँ। बाग़ में कितने पेड़ हैं?",
    "answerInStory": "120 — 24 को 20 + 4 में तोड़ो, फिर 5×20=100 और 5×4=20, और 100+20=120।"
  },
