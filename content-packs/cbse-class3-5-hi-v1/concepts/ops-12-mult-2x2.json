  "standardMethod": {
    "summary": "दोनों संख्याओं को स्थानीय-मान से तोड़ो; हर टुकड़े को हर टुकड़े से गुणा करो; चार आंशिक गुणनफल जोड़ो।",
    "steps": [
      "दोनों तोड़ो: 24 = 20+4, 15 = 10+5।",
      "चार टुकड़े: 20×10=200, 20×5=100, 4×10=40, 4×5=20।",
      "सबको जोड़ो: 200+100+40+20 = 360।",
      "अनुमान अंगरक्षक: 24×15 ≈ 25×15 ≈ 375 — 360 फ़िट बैठता है ✓"
    ]
  },
