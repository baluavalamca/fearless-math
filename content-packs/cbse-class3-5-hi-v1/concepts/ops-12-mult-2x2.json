{
  "id": "ops-12-mult-2x2",
  "name": "2-अंकों को 2-अंकों से गुणा — चार टुकड़े",
  "grade": 5,
  "strand": "operations",
  "prerequisites": [
    "ops-11-area-multiplication"
  ],
  "whatIsIt": "24 × 15 को गुणा करने के लिए, दोनों संख्याओं को स्थानीय-मान से तोड़ो: (20+4) × (10+5)। रस्सी की तरकीब अब बाग़ को चार टुकड़ों में काटती है: 20×10, 20×5, 4×10, 4×5। हर टुकड़े को गुणा करो, चारों को जोड़ो — 200+100+40+20 = 360। हर बड़ा गुणा दरअसल छोटे पहाड़े ही हैं, बस स्थानीय-मान का कोट पहने हुए।",
  "whyNeeded": "2-अंक × 2-अंक हर जगह दिखता है जहाँ असली मात्राएँ मिलती हैं: 15 लड्डुओं के 24 डिब्बे, 18 कुर्सियों की 12 पंक्तियाँ, 40 रुपये बचाने के 25 दिन। यह वह जगह भी है जहाँ स्तंभ विधि का 'दूसरी पंक्ति में शून्य जोड़ो' आख़िरकार समझ में आता है — चार टुकड़े इसे स्पष्ट कर देते हैं।",
  "realLifeUses": [
    "पार्टी का ऑर्डर: 24 डिब्बे, हर एक में 15 मिठाइयाँ",
    "हॉल की सीटें: 18 कुर्सियों की 12 पंक्तियाँ",
    "बचत: 31 दिनों तक रोज़ ₹25 बचाना",
    "स्कूल: 14 विद्यार्थियों के लिए 32 पन्नों का होमवर्क छापना"
  ],
  "vocabulary": [
