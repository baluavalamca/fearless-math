  "commonMistakes": [
    {
      "mistakeTag": "rule-from-two-only",
      "mistake": "सिर्फ़ पहले दो पदों से नियम अनुमान लगाना और बाकी को नज़रअंदाज़ करना।",
      "fix": "अपने नियम को हर दिए गए पद पर जाँचो। 2, 4, 8 '2 जोड़ो' नहीं है — अगला अंतर जाँचो: 4 से 8 तक +4 है, तो नियम है 'दोगुना करो'।"
    },
    {
      "mistakeTag": "added-instead-of-multiplied",
      "mistake": "जब पैटर्न असल में दोगुना हो रहा हो (या उल्टा) तब 'जोड़ो' का इस्तेमाल करना।",
      "fix": "अंतरों की तुलना करो। अगर अंतर बराबर हैं तो जोड़ हो रहा है; अगर संख्याएँ तेज़ी से बढ़ रही हैं, तो गुणा/दोगुना हो रहा है।"
