  ],
  "whatIsIt": "पैटर्न एक क्रम है जो किसी नियम का पालन करता है — एक दोहराने वाला या बढ़ने वाला विचार। एक बार जब तुम नियम ढूँढ लो (3 जोड़ो, दोगुना करो, आकार छोड़ो), तो तुम पैटर्न को हमेशा के लिए जारी रख सकते हो और सबको सूचीबद्ध किए बिना किसी भी कदम का अनुमान लगा सकते हो।",
  "whyNeeded": "पैटर्न गणित और दुनिया की धड़कन हैं: कैलेंडर, पहाड़े, फ़र्श की टाइलें, संगीत की धुनें, बढ़ती बचत। नियम पहचानना पहेली को भविष्यवाणी में बदल देता है — इसी तरह गणितज्ञ बहुत आगे तक देख पाते हैं।",
  "realLifeUses": [
    "तारीखों का अनुमान लगाना: हर 7वाँ दिन वही हफ्ते का दिन होता है",
    "रंगोली और टाइल की डिज़ाइनें जो किसी आकार-नियम को दोहराती हैं",
    "हर हफ्ते ₹5 ज़्यादा बचाना — एक बढ़ता हुआ संख्या पैटर्न",
    "मोतियों की माला या संगीत की धुनें जो दोहराती हैं"
  ],
  "vocabulary": [
