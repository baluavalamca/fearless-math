  "story": {
    "title": "कोलम पैटर्न का गुप्त नियम",
    "characters": [
      "मीना",
      "उसकी माँ"
    ],
    "text": "सुबह-सुबह मीना बिंदुओं की पंक्तियों से कोलम बनाती है: 2, फिर 4, फिर 6, फिर 8। 'आगे क्या आएगा?' माँ पूछती हैं। मीना ध्यान से देखती है। 'नियम ढूँढो — तुम एक पंक्ति से अगली तक कैसे पहुँचते हो?' मीना उसे पकड़ लेती है: 'हर पंक्ति 2 जोड़ती है! तो अगली 10 है, फिर 12।' 'नियम ढूँढो,' माँ मुस्कुराती हैं, 'और तुम पैटर्न को जितना चाहो उतना आगे ले जा सकती हो।'",
    "extractedProblem": "एक पैटर्न है 2, 4, 6, 8, ... नियम क्या है और अगली संख्या क्या है?",
    "answerInStory": "नियम है 'हर बार 2 जोड़ो', तो अगली संख्या 10 है।"
  },
