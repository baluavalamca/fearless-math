  "standardMethod": {
    "summary": "एक पद की अगले से तुलना करके नियम ढूँढो, फिर जारी रखने या अनुमान लगाने के लिए नियम लगाओ।",
    "steps": [
      "देखो हर पद अगले में कैसे बदलता है: जुड़ता है, घटता है, दोगुना होता है, या दोहराता है?",
      "नियम को शब्दों में बताओ (जैसे, '3 जोड़ो', 'दोगुना करो')।",
      "जाँचो कि नियम सभी दिए गए पदों पर काम करता है, सिर्फ़ पहले दो पर नहीं।",
      "अगला पद ढूँढने (या आगे कूदने) के लिए नियम लगाओ।"
    ]
  },
